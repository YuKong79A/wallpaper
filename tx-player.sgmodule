#!name=糖心Vlog + 外部播放器
#!desc=糖心Vlog 解锁点播、去除广告并支持外部播放器跳转
#!icon=https://txscript.pages.dev/tx/icon.png
#!category=18+
#!arguments=播放器:SenPlayer,自定义scheme:none,URL编码:default,播放器跳转:yes
#!arguments-desc=播放器: lenna / SenPlayer / SenPlayer-dl / Infuse / Fileball / VidHub / IINA / Alook / VLC / KMPlayer / NPlayer / Safari\n自定义scheme: 填写后覆盖播放器，例如 myplayer://play?url=；none 表示关闭\nURL编码: yes / no / default（按播放器默认值）\n播放器跳转: yes / no

[URL Rewrite]
^https?:\/\/((?:[a-z]+\.)?txh\d+\.com)\/(h5\/(?:user\/info|system\/info|movie\/(?:detail|block|search))) https://txscript.pages.dev/tx/$1/$2 header

[Script]
糖心播放器跳转 = type=http-request, pattern=^https?:\/\/(?:[a-z]+\.)?txh(?:066|067|068|069|087)\.com\/h5\/m3u8\/link\/[^/?]+\.m3u8(?:\?.*)?$, timeout=5, script-path=https://raw.githubusercontent.com/Yu9191/Rewrite/refs/heads/main/tx/tx-player.js, argument=player={{{播放器}}}&scheme={{{自定义scheme}}}&encode={{{URL编码}}}&jump={{{播放器跳转}}}

[MITM]
hostname = %APPEND% *.txh066.com, *.txh067.com, *.txh068.com, *.txh069.com, *.txh087.com, txh066.com, txh067.com, txh068.com, txh069.com, txh087.com
